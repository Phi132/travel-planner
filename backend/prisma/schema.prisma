generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  fullName      String          @map("full_name")
  avatarUrl     String?         @map("avatar_url")
  phone         String?
  role          UserRole        @default(USER)
  bio           String?         @db.Text
  dateOfBirth   DateTime?       @map("date_of_birth")
  isActive      Boolean         @default(true) @map("is_active")
  lastLoginAt   DateTime?       @map("last_login_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  expenses      Expense[]
  favorites     Favorite[]
  journals      Journal[]
  notifications Notification[]
  photos        Photo[]
  placeNotes    PlaceUserNote[]
  refreshTokens RefreshToken[]
  trips         Trip[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique @db.VarChar(512)
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Province {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  region      String?
  description String?    @db.Text
  imageUrl    String?    @map("image_url")
  isFeatured  Boolean    @default(false) @map("is_featured")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  districts   District[]
  places      Place[]

  @@index([slug])
  @@index([deletedAt])
  @@map("provinces")
}

model District {
  id         String    @id @default(uuid())
  provinceId String    @map("province_id")
  name       String
  slug       String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  province   Province  @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  places     Place[]

  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([deletedAt])
  @@map("districts")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  colorHex  String?   @map("color_hex")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  places    Place[]

  @@index([slug])
  @@map("categories")
}

model Place {
  id            String          @id @default(uuid())
  name          String
  slug          String
  description   String?         @db.Text
  address       String          @db.VarChar(500)
  provinceId    String          @map("province_id")
  districtId    String?         @map("district_id")
  categoryId    String          @map("category_id")
  latitude      Decimal         @db.Decimal(10, 7)
  longitude     Decimal         @db.Decimal(10, 7)
  googleMapsUrl String?         @map("google_maps_url") @db.VarChar(500)
  openHours     String?         @map("open_hours")
  ticketPrice   String?         @map("ticket_price")
  ratingAvg     Decimal         @default(0.0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount   Int             @default(0) @map("rating_count")
  isFeatured    Boolean         @default(false) @map("is_featured")
  coverImageUrl String?         @map("cover_image_url") @db.VarChar(500)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  favorites     Favorite[]
  journalPlaces JournalPlace[]
  photos        Photo[]
  images        PlaceImage[]
  userNotes     PlaceUserNote[]
  category      Category        @relation(fields: [categoryId], references: [id])
  district      District?       @relation(fields: [districtId], references: [id])
  province      Province        @relation(fields: [provinceId], references: [id])
  schedules     TripSchedule[]

  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([districtId])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([deletedAt])
  @@fulltext([name, description])
  @@map("places")
}

model PlaceImage {
  id        String   @id @default(uuid())
  placeId   String   @map("place_id")
  url       String   @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_images")
}

model PlaceUserNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  note      String   @db.Text
  rating    Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
  @@map("place_user_notes")
}

model Trip {
  id             String     @id @default(uuid())
  userId         String     @map("user_id")
  name           String
  description    String?    @db.Text
  startDate      DateTime   @map("start_date")
  endDate        DateTime   @map("end_date")
  companions     String?    @db.Text
  budget         Decimal?   @db.Decimal(14, 2)
  transportation String?
  status         TripStatus @default(PREPARING)
  coverImageUrl  String?    @map("cover_image_url") @db.VarChar(500)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  expenses       Expense[]
  journals       Journal[]
  photos         Photo[]
  days           TripDay[]
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@map("trips")
}

model TripDay {
  id        String         @id @default(uuid())
  tripId    String         @map("trip_id")
  dayNumber Int            @map("day_number")
  date      DateTime
  notes     String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  journals  Journal[]
  photos    Photo[]
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  schedules TripSchedule[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
  @@map("trip_days")
}

model TripSchedule {
  id                String   @id @default(uuid())
  tripDayId         String   @map("trip_day_id")
  placeId           String?  @map("place_id")
  title             String
  startTime         String   @map("start_time")
  endTime           String?  @map("end_time")
  note              String?  @db.Text
  travelTimeMinutes Int?     @map("travel_time_minutes")
  sortOrder         Int      @default(0) @map("sort_order")
  isCompleted       Boolean  @default(false) @map("is_completed")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  place             Place?   @relation(fields: [placeId], references: [id])
  tripDay           TripDay  @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
  @@index([placeId])
  @@index([sortOrder])
  @@map("trip_schedules")
}

model Journal {
  id        String         @id @default(uuid())
  tripId    String         @map("trip_id")
  tripDayId String?        @map("trip_day_id")
  userId    String         @map("user_id")
  date      DateTime
  content   String?        @db.Text
  mood      String?
  weather   Weather?
  rating    Int?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  deletedAt DateTime?      @map("deleted_at")
  photos    JournalPhoto[]
  places    JournalPlace[]
  tripDay   TripDay?       @relation(fields: [tripDayId], references: [id])
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@index([date])
  @@index([deletedAt])
  @@index([tripDayId], map: "journals_trip_day_id_fkey")
  @@map("journals")
}

model JournalPlace {
  id        String   @id @default(uuid())
  journalId String   @map("journal_id")
  placeId   String   @map("place_id")
  createdAt DateTime @default(now()) @map("created_at")
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([journalId, placeId])
  @@index([placeId], map: "journal_places_place_id_fkey")
  @@map("journal_places")
}

model Photo {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  tripId       String?        @map("trip_id")
  tripDayId    String?        @map("trip_day_id")
  placeId      String?        @map("place_id")
  url          String         @db.VarChar(500)
  thumbnailUrl String?        @map("thumbnail_url") @db.VarChar(500)
  type         MediaType      @default(PHOTO)
  caption      String?        @db.Text
  takenAt      DateTime?      @map("taken_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  deletedAt    DateTime?      @map("deleted_at")
  journalLinks JournalPhoto[]
  place        Place?         @relation(fields: [placeId], references: [id])
  tripDay      TripDay?       @relation(fields: [tripDayId], references: [id])
  trip         Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([tripDayId])
  @@index([deletedAt])
  @@index([placeId], map: "photos_place_id_fkey")
  @@map("photos")
}

model JournalPhoto {
  id        String   @id @default(uuid())
  journalId String   @map("journal_id")
  photoId   String   @map("photo_id")
  createdAt DateTime @default(now()) @map("created_at")
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([journalId, photoId])
  @@index([photoId], map: "journal_photos_photo_id_fkey")
  @@map("journal_photos")
}

model Expense {
  id          String          @id @default(uuid())
  tripId      String          @map("trip_id")
  userId      String          @map("user_id")
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  description String?
  date        DateTime
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@index([category])
  @@index([date])
  @@index([deletedAt])
  @@map("expenses")
}

model Favorite {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  placeId   String         @map("place_id")
  status    FavoriteStatus @default(WANT_TO_GO)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  place     Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
  @@index([status])
  @@map("favorites")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  content   String           @db.Text
  linkUrl   String?          @map("link_url")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum UserRole {
  USER
  ADMIN
}

enum TripStatus {
  PREPARING
  ONGOING
  COMPLETED
}

enum ExpenseCategory {
  FOOD
  HOTEL
  TRANSPORT
  SHOPPING
  TICKET
  OTHER
}

enum FavoriteStatus {
  WANT_TO_GO
  VISITED
  LOVED
}

enum NotificationType {
  TRIP_REMINDER
  TRIP_STARTING
  BUDGET_WARNING
  MEMORY
  SYSTEM
}

enum Weather {
  SUNNY
  CLOUDY
  RAINY
  STORMY
  COOL
  HOT
  SNOWY
}

enum MediaType {
  PHOTO
  VIDEO
}
