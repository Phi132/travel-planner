# Môi trường
NODE_ENV=development
PORT=4000

# Database (MySQL) - Prisma connection string
# Định dạng: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:123456@localhost:3307/travel_planner"

# JWT
JWT_ACCESS_SECRET=doi_chuoi_bi_mat_nay_thanh_gia_tri_ngau_nhien_manh
JWT_REFRESH_SECRET=doi_chuoi_bi_mat_khac_cho_refresh_token_ngau_nhien
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS - domain frontend được phép gọi API
CORS_ORIGIN=http://localhost:5173

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Google Maps (dùng ở backend nếu cần geocode - điền key thật của bạn)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
